# Database connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Database KHUSUS tes (wajib berbeda dari DATABASE_URL; Vitest menolak berjalan bila kosong/sama)
# Contoh: createdb -h localhost -U threads_monitoring threads_monitoring_test
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:PORT/threads_monitoring_test?schema=public"

# Auth token for Petugas Input actions (login & session cookie)
INPUT_TOKEN="change_me_to_a_secure_token"

# Extension Bearer token (specifically for Chrome Extension POST /api/mentions drafts)
EXTENSION_TOKEN="change_me_to_a_secure_extension_token"

# Session secret untuk verifikasi HMAC-SHA256 cookie sesi Petugas Input (wajib minimal 32 karakter).
# Generate string acak aman: openssl rand -hex 32
SESSION_SECRET="<random-32-bytes-hex-atau-base64>"

# LLM Provider selection (e.g. gemini, groq, openai)
LLM_PROVIDER="gemini"

# LLM API Keys (uncomment and fill the relevant key according to LLM_PROVIDER)
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
GEMINI_TIMEOUT_MS=15000

# Pratinjau Otomatis Threads (FR-02, Tahap 3A)
# Default: true di dev/test, false di produksi (kill switch).
# PERHATIAN: Di lingkungan produksi, pastikan kepatuhan dan batasan telah disetujui oleh tim hukum/kepatuhan sebelum diaktifkan (true).
PREVIEW_ENABLED=false

# Notifikasi Email Alert (Resend REST API)
# Catatan: Tanpa domain terverifikasi di Resend, pengiriman hanya bisa ke email pemilik akun.
RESEND_API_KEY=re_xxx
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=BTN Threads Alert <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000

