# Database connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Auth token for Petugas Input actions
INPUT_TOKEN="change_me_to_a_secure_token"

# LLM Provider selection (e.g. gemini, groq, openai)
LLM_PROVIDER="gemini"

# LLM API Keys (uncomment and fill the relevant key according to LLM_PROVIDER)
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
